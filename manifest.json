  "excluded_sources": [
    {
      "path": ".grok/skills/{docx,pptx,xlsx}",
      "why": "Anthropic document skills, proprietary license (LICENSE.txt) \u2014 not ours to republish"
    },
    {
      "path": ".grok/skills/{check,help,create-skill}",
      "why": "grok-build's own skills (xAI)"
    },
    {
      "path": ".grok/bundled/*",
      "why": "grok-build bundled skills (xAI)"
    },
    {
      "path": ".local/secondary_skills/*",
      "why": "Replit-provided sample skills"
    },
    {
      "path": ".claude/plugins/**",
      "why": "plugin marketplaces (third-party)"
    },
    {
      "path": "aidenybai/**",
      "why": "vendored upstream repos"
    },
    {
      "path": ".cache/pkg/**, .bench-hosting/**, .claude/worktrees/**, **/.cortex/builtin/**, *-extracted/**",
      "why": "caches, worktree copies, mirrors"
    }
  ],
